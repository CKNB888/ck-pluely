{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CK Pluely",
  "version": "2.0.0",
  "identifier": "io.github.cknb6.ckpluely",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "CK Pluely - AI 实时助手",
        "width": 600,
        "height": 54,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "resizable": false,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "visible": true,
        "center": false,
        "contentProtected": true,
        "focus": false,
        "acceptFirstMouse": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; img-src 'self' data: blob: https: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost https: http://localhost:* http://127.0.0.1:* ws://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "info.plist",
      "pluely.desktop"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "nsis": {
        "compression": "lzma",
        "installerHooks": "windows/hooks.nsh"
      },
      "wix": {
        "fragmentPaths": [
          "windows/purge.wxs"
        ],
        "componentRefs": [
          "CkPurgeMarker"
        ]
      }
    },
    "linux": {
      "deb": {
        "postRemoveScript": "linux/postrm.sh"
      },
      "rpm": {
        "postRemoveScript": "linux/postrm.sh"
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:pluely.db"
      ]
    },
    "updater": {
      "endpoints": [
        "https://github.com/CKNB888/ck-pluely/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2RDJBNUFFM0ZCREEyQjEKUldTeG9yMC9ycVhTWmlBRkovV2N5L3RudDhTTHFzM3QxSkF0R0doRGtvSUJKWktpdGp4cWRhcmcK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
