{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "panel",
  "description": "菜单栏面板：事件、拖动、打开链接 / 在文件夹中显示",
  "windows": ["panel"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-hide",
    "opener:default",
    "opener:allow-open-url",
    "opener:allow-reveal-item-in-dir"
  ]
}
