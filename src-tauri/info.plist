<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Microphone Access - Only for voice input, NOT for system audio capture -->
  <key>NSMicrophoneUsageDescription</key>
  <string>CK Pluely 需要使用麦克风进行语音输入（系统音频采集不会使用麦克风）。CK Pluely needs the microphone for voice input.</string>
  
  <!-- Screen Capture -->
  <key>NSScreenCaptureUsageDescription</key>
  <string>CK Pluely 需要屏幕录制权限来截图并识别屏幕内容。CK Pluely needs screen capture for screenshots.</string>
  
  <!-- System Audio -->
  <key>NSAudioCaptureUsageDescription</key>
  <string>CK Pluely 需要采集系统音频（对方说话的声音）以实时转写并生成 AI 回答。CK Pluely needs system audio for live transcription.</string>

  <!-- Privacy - Audio Processing -->
  <key>NSPrivacyAccessedAPITypes</key>
  <array>
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryAudioProcessing</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>C617.1</string>
      </array>
    </dict>
  </array>
  
  <!-- Hardened Runtime Entitlements -->
  <key>com.apple.security.device.microphone</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
